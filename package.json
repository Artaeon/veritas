{
  "name": "veritas",
  "version": "0.2.0",
  "private": true,
  "description": "A deterministic knowledge compiler and reasoning runtime",
  "license": "Apache-2.0",
  "author": {
    "name": "Artaeon",
    "email": "raphael.lugmayr@stoicera.com"
  },
  "keywords": [
    "deterministic-reasoning",
    "knowledge-representation",
    "logic-programming",
    "paraconsistent-logic",
    "proof-traces"
  ],
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "veritas": "dist/src/cli.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean --silent && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "hardening": "npm run check && npm test && npm audit --audit-level=high",
    "gate:v0.2": "npm run check && npm test && npm audit --audit-level=high",
    "demo": "npm run build --silent && node scripts/friendly-demo.mjs",
    "veritas": "npm run build --silent && node dist/src/cli.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
